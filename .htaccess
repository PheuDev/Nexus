Options -Indexes
DirectoryIndex public/index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Keep application source, configuration, and project metadata private.
    RewriteRule ^(?:config|core|controllers|models|views|lang|database|\.git|\.codex|\.aws)(?:/|$) - [F,L,NC]
    RewriteRule (^|/)\. - [F,L]
    RewriteRule \.(?:sql|md)$ - [F,L,NC]

    # Expose the public directory at the account's domain root.
    RewriteRule ^$ public/index.php [L]
    RewriteRule ^(index\.php|manifest\.json|sw\.js|assets/.*)$ public/$1 [L]
</IfModule>
