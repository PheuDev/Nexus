Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Keep application source, configuration, and project metadata private.
    RewriteRule ^(?:config|core|controllers|models|views|lang|database|\.git|\.codex|\.aws)(?:/|$) - [F,L,NC]
    RewriteRule (^|/)\. - [F,L]
    RewriteRule \.(?:sql|md)$ - [F,L,NC]

    # Route public assets through the application's public directory.
    RewriteRule ^(manifest\.json|sw\.js|assets/.*)$ public/$1 [L]
</IfModule>
